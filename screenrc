startup_message off
term screen-256color

autodetach on
vbell off

deflogin on
defutf8 on

shell bash 
shelltitle '$ |bash'
shell -$SHELL

altscreen on
nonblock on
mousetrack on

msgwait 1
defscrollback 100000

defmonitor on
activity ""
rendition monitor "=b rw"

caption always "%{= kw}%-w%{=b BW}%n %t%{= kw}%+w %-= %H %m/%d %c "
hardstatus alwayslastline

bind ',' prev
bind '.' next

bind = resize =
bind + resize +1
bind - resize -1
bind _ resize max

bind r source ~/.screenrc

# Make xterm scrolling work properly with screen.
termcapinfo xterm-256color|xterm-color|xterm|xterms|xs|rxvt ti@:te@

layout save default

